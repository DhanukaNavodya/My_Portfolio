# Contact form — EmailJS (https://www.emailjs.com)
# Copy this file to `.env` and fill in the values from your EmailJS dashboard.
# Without them, the form validates and opens the visitor's email app instead.
#
# Template variables you can use: {{from_name}} {{from_email}} {{reply_to}} {{subject}} {{message}} {{sent_at}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
